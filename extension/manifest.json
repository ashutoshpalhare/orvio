{
  "manifest_version": 3,
  "name": "ApratimTab",
  "short_name": "ApratimTab",
  "version": "1.0.0",
  "description": "A premium new-tab productivity dashboard by Ashutosh Palhare.",
  "author": "Ashutosh Palhare",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "bookmarks", "history", "tabs", "favicon"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "ApratimTab",
    "default_icon": "icon.png"
  }
}